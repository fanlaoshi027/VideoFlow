<Window x:Class="VideoFlow.App.DirectoryImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入教材目录" Height="650" Width="1000" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="导入教材目录" FontSize="26" FontWeight="SemiBold"/>
            <Button x:Name="ChooseFileButton" Content="选择 Excel" Width="110" Height="36" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="ChooseFileButton_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#F5F7FA" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="文件：" FontWeight="SemiBold"/>
                <TextBlock x:Name="FilePathText" Text="尚未选择" Margin="6,0,24,0"/>
                <TextBlock x:Name="SummaryText" Text=""/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Excel行" Binding="{Binding RowNumber}" Width="70"/>
                <DataGridTextColumn Header="页码" Binding="{Binding PageCode}" Width="80"/>
                <DataGridTextColumn Header="目录名称" Binding="{Binding CatalogTitle}" Width="2*"/>
                <DataGridTextColumn Header="章节" Binding="{Binding Chapter}" Width="160"/>
                <DataGridTextColumn Header="小节" Binding="{Binding Section}" Width="160"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="100" Height="38" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="ImportButton" Content="确认导入" Width="110" Height="38" IsEnabled="False" Click="ImportButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
