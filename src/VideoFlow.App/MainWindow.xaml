<Window x:Class="VideoFlow.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VideoFlow" Height="720" Width="1200" MinHeight="600" MinWidth="1000">
  <Grid Background="#F5F7FA">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#123A63">
      <StackPanel Margin="18">
        <TextBlock Text="VideoFlow" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="6,10,6,28"/>
        <Button Content="视频库" Margin="0,0,0,8" Height="42"/>
        <Button Content="教材库" Margin="0,0,0,8" Height="42"/>
        <Button Content="发布中心" Margin="0,0,0,8" Height="42"/>
        <Button Content="标签库" Margin="0,0,0,8" Height="42"/>
        <Button Content="平台管理" Margin="0,0,0,8" Height="42"/>
        <Separator Margin="0,18"/>
        <Button Content="设置" Height="42"/>
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,18">
        <TextBlock Text="视频库" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
          <Button Content="导入视频" Width="100" Height="38" Margin="8,0,0,0"/>
          <Button Content="一键整理" Width="100" Height="38" Margin="8,0,0,0"/>
        </StackPanel>
      </DockPanel>

      <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
        <DockPanel>
          <TextBox Width="300" Height="34" Padding="10,6" Text="搜索视频、页码、目录……"/>
          <ComboBox Width="180" Height="34" Margin="12,0,0,0">
            <ComboBoxItem Content="全部教材"/>
            <ComboBoxItem Content="八上《大培优》"/>
          </ComboBox>
          <ComboBox Width="150" Height="34" Margin="12,0,0,0">
            <ComboBoxItem Content="全部状态"/>
            <ComboBoxItem Content="待发布"/>
            <ComboBoxItem Content="已发布"/>
          </ComboBox>
        </DockPanel>
      </Border>

      <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="页码" Binding="{Binding Page}" Width="75"/>
            <DataGridTextColumn Header="目录" Binding="{Binding Title}" Width="2*"/>
            <DataGridTextColumn Header="视频" Binding="{Binding FileName}" Width="2*"/>
            <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="90"/>
            <DataGridTextColumn Header="抖音" Binding="{Binding DouyinStatus}" Width="90"/>
            <DataGridTextColumn Header="小红书" Binding="{Binding XiaohongshuStatus}" Width="90"/>
            <DataGridTextColumn Header="B站" Binding="{Binding BilibiliStatus}" Width="90"/>
            <DataGridTextColumn Header="操作" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
  </Grid>
</Window>
